AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
PORT=8787

# Refund records → Feishu (企业自建应用: wiki:wiki:readonly, sheets:spreadsheet, bitable:app;
# publish a version, then add the app to the refund wiki page via "… → 添加文档应用")
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# Link to the refund table: a /sheets/… or /base/…?table=… link works without wiki access;
# a /wiki/… link needs the app to have wiki-space access.
# FEISHU_REFUND_URL=https://xxx.feishu.cn/base/xxxx?table=tblxxxx
