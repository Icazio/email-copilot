AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
PORT=8787

# Admin console: http://localhost:8787/admin/
# First start only: set both to create the initial administrator.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters

# Use 0.0.0.0 to accept company-network connections.
HOST=127.0.0.1
# Required for assistant connections from other computers; put the same value in extension Config.
# COPILOT_ACCESS_TOKEN=replace-with-a-long-random-secret

# For an HTTPS reverse proxy, enable Secure cookies and set the external origin.
ADMIN_SECURE_COOKIE=false
# ADMIN_ORIGIN=https://copilot.company.example
# ADMIN_DATA_DIR=D:/copilot-data
